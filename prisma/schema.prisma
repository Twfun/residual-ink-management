generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/src/generated/client"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserAccount {
  id                 BigInt         @id @default(autoincrement())
  username           String         @unique @db.VarChar(80)
  passwordHash       String         @map("password_hash") @db.VarChar(120)
  displayName        String         @map("display_name") @db.VarChar(120)
  roleCode           String         @map("role_code") @db.VarChar(40)
  enabled            Boolean        @default(true)
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  lastLoginAt        DateTime?      @map("last_login_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  role               Role           @relation(fields: [roleCode], references: [code])
  logs               OperationLog[]

  @@index([roleCode], map: "idx_user_role")
  @@map("user_account")
}

model LoginAttempt {
  username    String    @id @db.VarChar(80)
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("login_attempt")
}

model Role {
  code        String           @id @db.VarChar(40)
  name        String           @db.VarChar(80)
  description String?          @db.VarChar(300)
  sortOrder   Int              @default(0) @map("sort_order")
  enabled     Boolean          @default(true)
  users       UserAccount[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  code      String           @id @db.VarChar(80)
  label     String           @db.VarChar(120)
  module    String           @db.VarChar(40)
  sortOrder Int              @default(0) @map("sort_order")
  roles     RolePermission[]

  @@index([module], map: "idx_permission_module")
  @@map("permission")
}

model RolePermission {
  roleCode       String     @map("role_code") @db.VarChar(40)
  permissionCode String     @map("permission_code") @db.VarChar(80)
  role           Role       @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleCode, permissionCode])
  @@map("role_permission")
}

model ResidualInk {
  id              BigInt     @id @default(autoincrement())
  storageLocation String     @unique @map("storage_location") @db.VarChar(120)
  rollerColorCode String?    @map("roller_color_code") @db.VarChar(200)
  inboundDate     DateTime?  @map("inbound_date") @db.Date
  weightKg        Decimal?   @map("weight_kg") @db.Decimal(12, 3)
  lStar           Decimal?   @map("l_star") @db.Decimal(8, 4)
  aStar           Decimal?   @map("a_star") @db.Decimal(8, 4)
  bStar           Decimal?   @map("b_star") @db.Decimal(8, 4)
  colorFamily     String?    @map("color_family") @db.VarChar(120)
  note2           String?    @db.VarChar(500)
  note3           String?    @db.VarChar(500)
  status          String     @default("在库") @db.VarChar(20)
  createdBy       String?    @map("created_by") @db.VarChar(80)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedBy       String?    @map("updated_by") @db.VarChar(80)
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")
  outboundRecords OutboundRecord[]
  formulaId      BigInt?    @map("formula_id")
  productId      BigInt?    @map("product_id")
  formula        Formula?   @relation(fields: [formulaId], references: [id], onDelete: SetNull)
  product        Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  adjustments    FormulaAdjustment[]

  @@index([status], map: "idx_residual_status")
  @@index([inboundDate], map: "idx_residual_inbound")
  @@index([formulaId], map: "idx_residual_formula")
  @@index([productId], map: "idx_residual_product")
  @@map("residual_ink")
}

model OutboundRecord {
  id                    BigInt       @id @default(autoincrement())
  residualInkId         BigInt?      @map("residual_ink_id")
  outboundDate          DateTime     @map("outbound_date") @db.Date
  outboundNo            String       @map("outbound_no") @db.VarChar(80)
  storageLocation       String       @map("storage_location") @db.VarChar(120)
  rollerColorCode       String?      @map("roller_color_code") @db.VarChar(200)
  inboundDate           DateTime?    @map("inbound_date") @db.Date
  weightKg              Decimal?     @map("weight_kg") @db.Decimal(12, 3)
  lStar                 Decimal?     @map("l_star") @db.Decimal(8, 4)
  aStar                 Decimal?     @map("a_star") @db.Decimal(8, 4)
  bStar                 Decimal?     @map("b_star") @db.Decimal(8, 4)
  deltaE                Decimal?     @map("delta_e") @db.Decimal(10, 4)
  colorFamily           String?      @map("color_family") @db.VarChar(120)
  note2                 String?      @db.VarChar(500)
  note3                 String?      @db.VarChar(500)
  importedHistorical    Boolean      @default(false) @map("imported_historical")
  createdBy             String?      @map("created_by") @db.VarChar(80)
  createdAt             DateTime     @default(now()) @map("created_at")
  residualInk           ResidualInk? @relation(fields: [residualInkId], references: [id], onDelete: SetNull)

  @@unique([outboundNo, storageLocation], map: "uk_outbound_no_location")
  @@index([outboundDate], map: "idx_outbound_date")
  @@index([residualInkId], map: "idx_outbound_inventory")
  @@map("outbound_record")
}

model ColorMeasurement {
  id                 BigInt   @id @default(autoincrement())
  lStar              Decimal  @map("l_star") @db.Decimal(8, 4)
  aStar              Decimal  @map("a_star") @db.Decimal(8, 4)
  bStar              Decimal  @map("b_star") @db.Decimal(8, 4)
  densityT           Decimal? @map("density_t") @db.Decimal(8, 4)
  source             String   @db.VarChar(30)
  instrumentSerial   String?  @map("instrument_serial") @db.VarChar(80)
  instrumentModel    String?  @map("instrument_model") @db.VarChar(120)
  measureCondition   String?  @map("measure_condition") @db.VarChar(120)
  measuredBy         String?  @map("measured_by") @db.VarChar(80)
  measuredAt         DateTime @default(now()) @map("measured_at")
  deletedAt          DateTime? @map("deleted_at")

  @@index([measuredAt], map: "idx_measurement_time")
  @@map("color_measurement")
}

model ImportJob {
  id          BigInt   @id @default(autoincrement())
  fileName    String   @map("file_name") @db.VarChar(255)
  fileSha256  String   @map("file_sha256") @db.Char(64)
  mode        String   @db.VarChar(20)
  inventoryRows Int   @default(0) @map("inventory_rows")
  outboundRows  Int   @default(0) @map("outbound_rows")
  importedRows  Int   @default(0) @map("imported_rows")
  skippedRows   Int   @default(0) @map("skipped_rows")
  errorRows     Int   @default(0) @map("error_rows")
  createdBy   String?  @map("created_by") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_import_time")
  @@map("import_job")
}

model OperationLog {
  id            BigInt       @id @default(autoincrement())
  userId        BigInt?      @map("user_id")
  username      String?      @db.VarChar(80)
  operationType String       @map("operation_type") @db.VarChar(80)
  targetTable   String?      @map("target_table") @db.VarChar(80)
  targetId      String?      @map("target_id") @db.VarChar(120)
  beforeData    Json?        @map("before_data")
  afterData     Json?        @map("after_data")
  ipAddress     String?      @map("ip_address") @db.VarChar(80)
  remark        String?      @db.VarChar(1000)
  operationTime DateTime     @default(now()) @map("operation_time")
  user          UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([operationTime], map: "idx_log_time")
  @@index([operationType], map: "idx_log_type")
  @@map("operation_log")
}

model DesktopConfig {
  configKey   String   @id @map("config_key") @db.VarChar(120)
  configValue String   @map("config_value") @db.Text
  description String?  @db.VarChar(300)
  updatedBy   String?  @map("updated_by") @db.VarChar(80)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("desktop_config")
}

model BackupJob {
  id           BigInt    @id @default(autoincrement())
  jobType      String    @map("job_type") @db.VarChar(20)
  status       String    @db.VarChar(30)
  fileName     String?   @map("file_name") @db.VarChar(255)
  fileSize     BigInt?   @map("file_size")
  sha256       String?   @db.Char(64)
  createdBy    String?   @map("created_by") @db.VarChar(80)
  createdAt    DateTime  @default(now()) @map("created_at")
  finishedAt   DateTime? @map("finished_at")
  errorMessage String?   @map("error_message") @db.Text

  @@index([createdAt], map: "idx_backup_time")
  @@map("backup_job")
}

model Product {
  id            BigInt         @id @default(autoincrement())
  code          String         @unique @db.VarChar(80)
  formulaNo     String?        @map("formula_no") @db.VarChar(80)
  archiveDate   DateTime?      @map("archive_date")
  name          String         @db.VarChar(200)
  customerName  String?        @map("customer_name") @db.VarChar(200)
  specification String?        @db.VarChar(200)
  substrate     String?        @db.VarChar(200)
  processNote   String?        @map("process_note") @db.VarChar(1000)
  status        String         @default("启用") @db.VarChar(20)
  createdBy     String?        @map("created_by") @db.VarChar(80)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedBy     String?        @map("updated_by") @db.VarChar(80)
  updatedAt     DateTime       @updatedAt @map("updated_at")
  colors        ProductColor[]
  residualInks  ResidualInk[]

  @@index([formulaNo], map: "idx_product_formula_no")
  @@map("product")
}

model ProductColor {
  id                   BigInt     @id @default(autoincrement())
  productId            BigInt     @map("product_id")
  name                 String     @db.VarChar(120)
  colorCode            String?    @map("color_code") @db.VarChar(80)
  printOrder           Int?       @map("print_order")
  targetColorData      Json?      @map("target_color_data")
  targetViscosity      Decimal?   @map("target_viscosity") @db.Decimal(8, 2)
  viscosityUnit        String     @default("s") @map("viscosity_unit") @db.VarChar(10)
  viscosityMethod      String?    @map("viscosity_method") @db.VarChar(120)
  viscosityTemperature Decimal?   @map("viscosity_temperature") @db.Decimal(6, 2)
  remark               String?    @db.VarChar(1000)
  status               String     @default("启用") @db.VarChar(20)
  createdBy            String?    @map("created_by") @db.VarChar(80)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedBy            String?    @map("updated_by") @db.VarChar(80)
  updatedAt            DateTime   @updatedAt @map("updated_at")
  product              Product    @relation(fields: [productId], references: [id])
  formulas             Formula[]

  @@index([productId], map: "idx_product_color_product")
  @@map("product_color")
}

model Material {
  id                   BigInt        @id @default(autoincrement())
  code                 String        @unique @db.VarChar(80)
  name                 String        @db.VarChar(200)
  materialType         String        @map("material_type") @db.VarChar(20)
  colorFamily          String?       @map("color_family") @db.VarChar(120)
  manufacturer         String?       @db.VarChar(200)
  brand                String?       @db.VarChar(120)
  series               String?       @db.VarChar(120)
  defaultViscosity     Decimal?      @map("default_viscosity") @db.Decimal(8, 2)
  viscosityUnit        String        @default("s") @map("viscosity_unit") @db.VarChar(10)
  viscosityMethod      String?       @map("viscosity_method") @db.VarChar(120)
  viscosityTemperature Decimal?      @map("viscosity_temperature") @db.Decimal(6, 2)
  density              Decimal?      @db.Decimal(8, 4)
  unitCost             Decimal?      @map("unit_cost") @db.Decimal(12, 4)
  isDefaultSolvent     Boolean       @default(false) @map("is_default_solvent")
  status               String        @default("启用") @db.VarChar(20)
  remark               String?       @db.VarChar(1000)
  createdBy            String?       @map("created_by") @db.VarChar(80)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedBy            String?       @map("updated_by") @db.VarChar(80)
  updatedAt            DateTime      @updatedAt @map("updated_at")
  formulaItems         FormulaItem[]

  @@index([materialType], map: "idx_material_type")
  @@index([name], map: "idx_material_name")
  @@map("material")
}

model Formula {
  id                   BigInt              @id @default(autoincrement())
  productColorId       BigInt              @map("product_color_id")
  versionNo            Int                 @map("version_no")
  status               String              @default("draft") @db.VarChar(20)
  basisType            String              @default("份数") @map("basis_type") @db.VarChar(10)
  targetViscosity      Decimal?            @map("target_viscosity") @db.Decimal(8, 2)
  viscosityUnit        String              @default("s") @map("viscosity_unit") @db.VarChar(10)
  viscosityMethod      String?             @map("viscosity_method") @db.VarChar(120)
  viscosityTemperature Decimal?            @map("viscosity_temperature") @db.Decimal(6, 2)
  applicableConditions Json?               @map("applicable_conditions")
  changeReason         String?             @map("change_reason") @db.VarChar(1000)
  remark               String?             @db.VarChar(1000)
  createdBy            String?             @map("created_by") @db.VarChar(80)
  createdAt            DateTime            @default(now()) @map("created_at")
  publishedBy          String?             @map("published_by") @db.VarChar(80)
  publishedAt          DateTime?           @map("published_at")
  productColor         ProductColor        @relation(fields: [productColorId], references: [id])
  items                FormulaItem[]
  adjustments          FormulaAdjustment[] @relation("adjustment_formula")
  promotedFrom         FormulaAdjustment[] @relation("promoted_formula")
  residualInks         ResidualInk[]

  @@unique([productColorId, versionNo], map: "uk_formula_version")
  @@index([productColorId, status], map: "idx_formula_color_status")
  @@map("formula")
}

model FormulaItem {
  id                   BigInt   @id @default(autoincrement())
  formulaId            BigInt   @map("formula_id")
  materialId           BigInt   @map("material_id")
  ratioPart            Decimal  @map("ratio_part") @db.Decimal(12, 4)
  ratioPercent         Decimal? @map("ratio_percent") @db.Decimal(10, 4)
  sortNo               Int      @default(0) @map("sort_no")
  componentNote        String?  @map("component_note") @db.VarChar(500)
  materialTypeSnapshot String?  @map("material_type_snapshot") @db.VarChar(20)
  manufacturerSnapshot String?  @map("manufacturer_snapshot") @db.VarChar(200)
  viscositySnapshot    String?  @map("viscosity_snapshot") @db.VarChar(200)
  formula              Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  material             Material @relation(fields: [materialId], references: [id])

  @@index([formulaId], map: "idx_formula_item_formula")
  @@index([materialId], map: "idx_formula_item_material")
  @@map("formula_item")
}

model FormulaAdjustment {
  id                    BigInt       @id @default(autoincrement())
  formulaId             BigInt       @map("formula_id")
  productionBatchNo     String?      @map("production_batch_no") @db.VarChar(80)
  targetWeight          Decimal?     @map("target_weight") @db.Decimal(12, 3)
  actualViscosityBefore Decimal?     @map("actual_viscosity_before") @db.Decimal(8, 2)
  actualViscosityAfter  Decimal?     @map("actual_viscosity_after") @db.Decimal(8, 2)
  viscosityUnit         String       @default("s") @map("viscosity_unit") @db.VarChar(10)
  adjustmentItems       Json         @map("adjustment_items")
  result                String?      @db.VarChar(40)
  remark                String?      @db.VarChar(1000)
  createdBy             String?      @map("created_by") @db.VarChar(80)
  createdAt             DateTime     @default(now()) @map("created_at")
  promotedFormulaId     BigInt?      @map("promoted_formula_id")
  residualInkId         BigInt?      @map("residual_ink_id")
  formula               Formula      @relation("adjustment_formula", fields: [formulaId], references: [id])
  promotedFormula       Formula?     @relation("promoted_formula", fields: [promotedFormulaId], references: [id])
  residualInk           ResidualInk? @relation(fields: [residualInkId], references: [id], onDelete: SetNull)

  @@index([formulaId], map: "idx_adjustment_formula")
  @@index([createdAt], map: "idx_adjustment_time")
  @@map("formula_adjustment")
}