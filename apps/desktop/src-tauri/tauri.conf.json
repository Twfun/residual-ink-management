{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "余墨管理系统",
  "version": "1.11.0",
  "identifier": "com.residualink.management.desktop",
  "build": {
    "beforeDevCommand": "npm --workspace apps/web run dev",
    "beforeBuildCommand": "npm run desktop:prepare",
    "devUrl": "http://127.0.0.1:39173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "余墨管理系统", "width": 1280, "height": 820, "minWidth": 1000, "minHeight": 650 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:39080; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/residual-ink-api"],
    "resources": ["resources/database", "resources/xrite/exact-bridge.exe", "resources/xrite/eXact.dll"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["SimpChinese"], "installerHooks": "installer-hooks.nsh", "template": "nsis-installer-template.nsi" }
    }
  }
}
